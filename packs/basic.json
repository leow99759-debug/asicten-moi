{
  "id": "basic",
  "name": "Основные",
  "description": "Базовые команды из эталонных сценариев (SPEC §11). Расширяется паками M6.",
  "category": "Система",
  "version": "0.1.0",
  "commands": [
    {"id": "basic.browser", "folder": ["Браузер"], "name": "Открыть браузер",
     "phrases": ["браузер", "интернет"], "optional": ["открой", "запусти", "включи", "мне"],
     "actions": [{"type": "Launch.Url", "url": "https://ya.ru"}],
     "reply": {"clips": ["done"], "text": "Запрос выполнен, сэр"}},
    {"id": "basic.close_window", "folder": ["Окна"], "name": "Закрыть окно",
     "phrases": ["закрой окно", "закрой это"], "actions": [{"type": "Window.Close"}],
     "reply": {"clips": ["ok"], "text": "Да, сэр"}},
    {"id": "basic.minimize_all", "folder": ["Окна"], "name": "Свернуть все окна",
     "phrases": ["сверни все окна", "сверни все", "покажи рабочий стол"],
     "actions": [{"type": "Window.MinimizeAll"}], "reply": {"clips": ["ok"], "text": "Да, сэр"}},
    {"id": "basic.volume_set", "folder": ["Звук"], "name": "Громкость на N",
     "phrases": ["громкость на {число}", "громкость {число}"],
     "actions": [{"type": "System.VolumeSet", "level": "{число}"}], "reply": {"clips": ["ok"], "text": "Да, сэр"}},
    {"id": "basic.volume_up", "folder": ["Звук"], "name": "Громче",
     "phrases": ["громче", "сделай громче", "прибавь громкость"],
     "actions": [{"type": "System.VolumeUp", "step": 10}], "reply": {"clips": ["ok"]}},
    {"id": "basic.volume_down", "folder": ["Звук"], "name": "Тише",
     "phrases": ["тише", "сделай тише", "убавь громкость"],
     "actions": [{"type": "System.VolumeDown", "step": 10}], "reply": {"clips": ["ok"]}},
    {"id": "basic.mute", "folder": ["Звук"], "name": "Выключить звук",
     "phrases": ["выключи звук", "без звука"], "actions": [{"type": "System.Mute"}], "reply": {"clips": ["ok"]}},
    {"id": "basic.music", "folder": ["Медиа"], "name": "Включить музыку",
     "phrases": ["включи музыку", "музыку"], "optional": ["поставь", "запусти"],
     "actions": [{"type": "Media.PlayPause"}], "reply": {"clips": ["loading"], "text": "Загружается"}},
    {"id": "basic.next", "folder": ["Медиа"], "name": "Следующий трек",
     "phrases": ["следующий трек", "следующая песня", "дальше"], "actions": [{"type": "Media.Next"}], "reply": {"clips": ["ok"]}},
    {"id": "basic.pause", "folder": ["Медиа"], "name": "Пауза",
     "phrases": ["пауза", "поставь на паузу"], "actions": [{"type": "Media.PlayPause"}], "reply": {"clips": ["ok"]}},
    {"id": "basic.shutdown", "folder": ["Питание"], "name": "Выключить компьютер",
     "phrases": ["выключи компьютер"], "chainable": false,
     "actions": [{"type": "System.Shutdown", "delay_sec": 30}], "reply": {"clips": ["off"], "text": "Выключаю, сэр"}},
    {"id": "basic.shutdown_in", "folder": ["Питание"], "name": "Выключить компьютер через время",
     "phrases": ["выключи компьютер через {время}"], "chainable": false,
     "actions": [{"type": "System.Shutdown", "delay_sec": "{время}"}], "reply": {"clips": ["ok"], "text": "Да, сэр"}},
    {"id": "basic.cancel_shutdown", "folder": ["Питание"], "name": "Отменить выключение",
     "phrases": ["отмени выключение", "не выключай компьютер"],
     "actions": [{"type": "System.CancelShutdown"}], "reply": {"clips": ["ok"], "text": "Выключение отменено, сэр"}},
    {"id": "basic.lock", "folder": ["Питание"], "name": "Заблокировать компьютер",
     "phrases": ["заблокируй компьютер", "блокировка"], "actions": [{"type": "System.Lock"}], "reply": {"clips": ["ok"]}},
    {"id": "basic.time", "folder": ["Информация"], "name": "Который час",
     "phrases": ["который час", "сколько времени", "время"], "actions": [{"type": "System.Info", "what": "time"}]},
    {"id": "basic.date", "folder": ["Информация"], "name": "Какое сегодня число",
     "phrases": ["какое сегодня число", "какой сегодня день", "дата"], "actions": [{"type": "System.Info", "what": "date"}]},
    {"id": "basic.battery", "folder": ["Информация"], "name": "Заряд батареи",
     "phrases": ["заряд батареи", "сколько заряда"], "actions": [{"type": "System.Info", "what": "battery"}]},
    {"id": "basic.screenshot", "folder": ["Система"], "name": "Скриншот",
     "phrases": ["сделай скриншот", "скриншот"], "actions": [{"type": "System.Screenshot"}], "reply": {"clips": ["ok"]}},
    {"id": "basic.remind", "folder": ["Таймеры"], "name": "Напомнить",
     "phrases": ["напомни через {время} {текст}"],
     "actions": [{"type": "Reminder", "sec": "{время}", "text": "{текст}"}], "reply": {"clips": ["ok"], "text": "Хорошо, сэр"}},
    {"id": "basic.thanks", "folder": ["Диалог"], "name": "Спасибо",
     "phrases": ["спасибо", "благодарю"], "reply": {"clips": ["thanks"], "text": "Всегда рад помочь, сэр"}},
    {"id": "basic.here", "folder": ["Диалог"], "name": "Ты тут",
     "phrases": ["ты тут", "ты здесь"], "reply": {"clips": ["ready"], "text": "Всегда к вашим услугам, сэр"}},
    {"id": "basic.howru", "folder": ["Диалог"], "name": "Как дела",
     "phrases": ["как дела", "как ты"], "reply": {"clips": ["status"], "text": "Всё в порядке, сэр. Я функционирую нормально"}}
  ]
}
