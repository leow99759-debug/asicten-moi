   "id": "edge.open",
   "folder": [
    "Microsoft Edge",
    "Запуск"
   ],
   "name": "Открыть Microsoft Edge",
   "phrases": [
    "эдж",
    "майкрософт эдж",
    "edge"
   ],
   "optional": [
    "открой",
    "запусти",
    "включи",
    "мне"
   ],
   "actions": [
    {
     "type": "Launch.File",
     "path": "%EDGE%"
    }
   ],
   "reply": {
    "clips": [
     "ok"
    ]
   }
  },
  {
   "id": "edge.close",
   "folder": [
    "Microsoft Edge",
    "Запуск"
   ],
   "name": "Закрыть Microsoft Edge",
   "phrases": [
    "закрой эдж",
    "закрой майкрософт эдж",
    "закрой edge",
    "выключи эдж"
   ],
   "actions": [
    {
     "type": "Run.Command.Hidden",
     "cmd": "taskkill /IM msedge.exe",
     "trusted": true
    }
   ],
   "reply": {
    "clips": [
     "ok"
    ]
   }
  },
  {
