     "path": "%YANDEX%"
    }
   ],
   "reply": {
    "clips": [
     "ok"
    ]
   }
  },
  {
   "id": "yandex.close",
   "folder": [
    "Яндекс Браузер",
    "Запуск"
   ],
   "name": "Закрыть Яндекс Браузер",
