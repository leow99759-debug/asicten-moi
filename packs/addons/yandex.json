   ],
   "actions": [
    {
     "type": "Run.Command.Hidden",
     "cmd": "taskkill /IM browser.exe",
     "trusted": true
    }
   ],
   "reply": {
    "clips": [
     "ok"
    ]
   }
  },
  {
