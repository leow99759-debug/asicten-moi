  {
   "id": "firefox.open",
   "folder": [
    "Mozilla Firefox",
    "Запуск"
   ],
   "name": "Открыть Mozilla Firefox",
   "phrases": [
    "файрфокс",
    "фаерфокс",
    "мозилла",
    "firefox"
   ],
   "optional": [
    "открой",
    "запусти",
    "включи",
    "мне"
   ],
   "actions": [
    {
     "type": "Launch.File",
     "path": "%FIREFOX%"
    }
   ],
   "reply": {
    "clips": [
     "ok"
    ]
   }
  },
  {
   "id": "firefox.close",
   "folder": [
    "Mozilla Firefox",
    "Запуск"
   ],
   "name": "Закрыть Mozilla Firefox",
   "phrases": [
    "закрой файрфокс",
    "закрой фаерфокс",
    "закрой мозилла",
    "закрой firefox",
    "выключи файрфокс"
   ],
   "actions": [
    {
     "type": "Run.Command.Hidden",
     "cmd": "taskkill /IM firefox.exe",
     "trusted": true
    }
   ],
   "reply": {
    "clips": [
     "ok"
    ]
   }
  },
  {
   "id": "firefox.search",
   "folder": [
    "Mozilla Firefox",
    "Запуск"
   ],
   "name": "Найти в Mozilla Firefox",
   "phrases": [
    "найди в файрфоксе {текст}",
    "поищи в файрфоксе {текст}"
   ],
   "actions": [
    {
     "type": "Launch.File",
     "path": "%FIREFOX%",
